#!/usr/bin/env python3
"""Group member accounts for LibreChat on 3080: keeps ~/Developer/nucleon-local/config/team-members.json (mode 600) and makes
sure every account in it exists in LibreChat, with view access to "Nucleon ADA Staff (Qwen)".
A password is generated once, when its account is first added, and never changed afterwards (stable for the demo),
unless --rotate is given: then every member gets a new password (use after a password was shown or leaked).
Then run bin/demo-launcher to get the copy buttons. Passwords are never printed.
Usage: team-accounts [--count N] [--rotate]   (default: keep the current list, or 6 accounts the first time)"""
import json, os, secrets, subprocess, sys

H = os.path.expanduser('~')
BASE = os.path.join(H, 'Developer', 'nucleon-local')
FILE = os.path.join(BASE, 'config', 'team-members.json')
JS = os.path.join(BASE, 'lib', 'librechat-team-accounts.js')
AGENT = 'agent_biPGuKnO2VgHEQ67HsLHL'   # "Nucleon ADA Staff (Qwen)"
ALPHABET = 'abcdefghjkmnpqrstuvwxyz23456789'   # no look-alike characters (l/1, o/0)


def password():
    return '-'.join(''.join(secrets.choice(ALPHABET) for _ in range(4)) for _ in range(4))


data = json.load(open(FILE)) if os.path.exists(FILE) else {'chatUrl': 'http://127.0.0.1:3080', 'members': []}
count = int(sys.argv[sys.argv.index('--count') + 1]) if '--count' in sys.argv else max(len(data['members']), 6)
rotate = '--rotate' in sys.argv
if rotate:
    for m in data['members']:
        m['password'] = password()
for n in range(len(data['members']) + 1, count + 1):
    data['members'].append({'name': 'Member %d' % n, 'email': 'member%d@nucleon.local' % n,
                            'username': 'member%d' % n, 'password': password()})
fd = os.open(FILE, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
os.write(fd, (json.dumps(data, indent=2) + '\n').encode()); os.close(fd); os.chmod(FILE, 0o600)

subprocess.run(['docker', 'cp', JS, 'LibreChat:/tmp/team-accounts.js'], check=True)
payload = json.dumps({'members': data['members'], 'agentId': AGENT, 'rotate': rotate})
r = subprocess.run(['docker', 'exec', '-i', 'LibreChat', 'node', '/tmp/team-accounts.js'], input=payload, text=True,
                   capture_output=True)
subprocess.run(['docker', 'exec', 'LibreChat', 'rm', '-f', '/tmp/team-accounts.js'])
lines = [l for l in r.stdout.splitlines() + r.stderr.splitlines() if l.startswith(('RESULT ', 'ERROR '))]
if r.returncode or not lines or not lines[-1].startswith('RESULT '):
    sys.exit('failed: ' + (lines[-1] if lines else 'no result (exit %d)' % r.returncode))
result = json.loads(lines[-1][7:])
for a in result['accounts']:
    print('%-28s %s' % (a['email'], a['status']))
print('ADA agent viewable by member accounts:', result['agentShared'])
print('list:', FILE, '(mode 600). Run bin/demo-launcher for the copy buttons.')
