<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Cloudflare Tunnel "nucleon-m3" for the PoV: https://nucleon.dracooz.top -> 127.0.0.1:8631 (Records),
  https://creditease.dracooz.top -> 127.0.0.1:3080 (LibreChat). The ingress rules live on Cloudflare (remotely managed
  tunnel); the token file (mode 600, never committed) is the only secret on this Mac.
  Install:   cp com.nucleon.cloudflared.plist ~/Library/LaunchAgents/ && launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/com.nucleon.cloudflared.plist
  Stop:      launchctl bootout gui/$(id -u)/com.nucleon.cloudflared      (loopback only again)
  Restart:   launchctl kickstart -k gui/$(id -u)/com.nucleon.cloudflared
  launchd does not expand "~" or "$HOME": the paths below are absolute on purpose.
-->
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.nucleon.cloudflared</string>
	<key>ProgramArguments</key>
	<array>
		<string>/Users/unitylht/Developer/nucleon-local/cloudflared/cloudflared</string>
		<string>tunnel</string>
		<string>run</string>
		<string>--token-file</string>
		<string>/Users/unitylht/Developer/nucleon-local/config/cloudflared-token</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<true/>
	<key>ThrottleInterval</key>
	<integer>10</integer>
	<key>ProcessType</key>
	<string>Background</string>
	<key>StandardOutPath</key>
	<string>/Users/unitylht/Developer/nucleon-local/logs/cloudflared.log</string>
	<key>StandardErrorPath</key>
	<string>/Users/unitylht/Developer/nucleon-local/logs/cloudflared.log</string>
</dict>
</plist>
