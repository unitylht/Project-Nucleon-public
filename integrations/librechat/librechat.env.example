# LibreChat .env: ONLY the keys that change for the public PoV (31 Oct 2026). Copy these lines into ~/Developer/LibreChat/.env
# (the live file, never committed; it also holds the secrets: JWT_*, CREDS_*, MONGO_URI, NUCLEON_*_MCP_TOKEN ...).
# Names checked against LibreChat v0.8.8 (api/server/index.js, packages/api/src/oauth/csrf.ts, packages/api/src/middleware/origin.ts).
# The api container must be recreated for env changes: docker compose up -d --no-deps --force-recreate api

# The public address of LibreChat (Cloudflare Tunnel hostname, behind Cloudflare Access). Was http://localhost:3080.
# DOMAIN_SERVER decides the Secure flag of the session cookies (HTTPS host, NODE_ENV=production -> Secure) and, with DOMAIN_CLIENT,
# the origins the login endpoints accept (requireSameOrigin). Keep both identical, no trailing slash, no path.
DOMAIN_CLIENT=https://creditease.dracooz.top
DOMAIN_SERVER=https://creditease.dracooz.top

# Number of reverse-proxy hops to trust when reading X-Forwarded-For (Express "trust proxy"). Read as Number(TRUST_PROXY) || 1:
# unset, 0 and non-numeric values all mean 1. The path here is Cloudflare edge -> cloudflared (on this Mac) -> LibreChat, and the edge puts the
# real visitor in X-Forwarded-For, so 1 makes req.ip that visitor and LibreChat's ban / rate-limit logic acts on one tester, not on everyone
# behind the tunnel. The default is already 1; it is set explicitly so nobody "fixes" it to 0. Do not raise it above the real hop count
# (a visitor could then forge their address).
TRUST_PROXY=1

# Closed pilot: testers use accounts created by bin/team-accounts or by the admin, nobody can sign up through the public hostname.
ALLOW_REGISTRATION=false
ALLOW_SOCIAL_REGISTRATION=false

# Optional. Secure cookies are only sent over HTTPS (or by Chrome to http://127.0.0.1). If the loopback address must keep working in Safari or
# Firefox for local use, set SESSION_COOKIE_SECURE=false: the public side is then protected by Access and HTTPS only, the cookie flag is lost.
# SESSION_COOKIE_SECURE=true
