@@ -0,0 +1,37 @@
+import { Atom } from 'lucide-react';
+import { Button, TooltipAnchor } from '@librechat/client';
+
+/** Build-time address (Vite env `VITE_NUCLEON_URL`); changing it needs a rebuild of the image. */
+export const NUCLEON_URL: string =
+  (import.meta.env.VITE_NUCLEON_URL as string | undefined)?.trim() || 'https://nucleon.dracooz.top';
+export const NUCLEON_LABEL = 'Nucleon';
+
+interface NucleonLinkButtonProps {
+  side?: 'right' | 'bottom';
+}
+
+/** Entry in the left rail that opens an external page (Nucleon) in a new tab. The label and
+ *  address are constants, not read from any conversation or server data. */
+export default function NucleonLinkButton({ side = 'right' }: NucleonLinkButtonProps) {
+  return (
+    <TooltipAnchor
+      side={side}
+      description={NUCLEON_LABEL}
+      render={
+        <Button asChild variant="ghost" size="icon" className="h-9 w-9 flex-shrink-0">
+          {/* noopener is enough: Nucleon is a sister service and may receive the Referer. */}
+          {/* eslint-disable-next-line react/jsx-no-target-blank */}
+          <a
+            href={NUCLEON_URL}
+            target="_blank"
+            rel="noopener"
+            data-testid="nav-nucleon-link"
+            aria-label={NUCLEON_LABEL}
+          >
+            <Atom className="h-5 w-5 text-text-primary" aria-hidden="true" />
+          </a>
+        </Button>
+      }
+    />
+  );
+}
