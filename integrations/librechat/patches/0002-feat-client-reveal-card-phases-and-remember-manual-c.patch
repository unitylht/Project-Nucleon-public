@@ -0,0 +1,40 @@
+import type { TMessageContentParts } from 'librechat-data-provider';
+import { ContentTypes } from 'librechat-data-provider';
+
+/**
+ * The reader's own open/closed choice for a disclosure that opens by default because it holds an
+ * MCP-UI card. Module-scoped and in memory only: it survives a remount while the page lives (a
+ * conversation switch, a list re-key) and is gone on reload, so a saved conversation with no
+ * recorded choice still reveals its card. Only manual toggles are written here; the automatic
+ * reveal never is.
+ */
+const choices = new Map<string, boolean>();
+
+export const getCardDisclosure = (key: string | undefined): boolean | undefined =>
+  key == null ? undefined : choices.get(key);
+
+export const setCardDisclosure = (key: string | undefined, open: boolean): void => {
+  if (key != null) {
+    choices.set(key, open);
+  }
+};
+
+/** Test seam: the store is process-global. */
+export const clearCardDisclosures = (): void => choices.clear();
+
+/** A stable key for a disclosure that wraps tool calls: the first call's provider id. */
+export const firstToolCallKey = (
+  prefix: string,
+  parts: ReadonlyArray<TMessageContentParts | undefined> | undefined,
+): string | undefined => {
+  for (const part of parts ?? []) {
+    if (part?.type !== ContentTypes.TOOL_CALL) {
+      continue;
+    }
+    const id = (part[ContentTypes.TOOL_CALL] as { id?: string } | undefined)?.id;
+    if (typeof id === 'string' && id.length > 0) {
+      return `${prefix}:${id}`;
+    }
+  }
+  return undefined;
+};
