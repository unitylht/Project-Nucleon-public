--- /dev/null
+++ b/client/src/components/MCPUIResource/supported.ts
@@ -0,0 +1,25 @@
+import { Tools } from 'librechat-data-provider';
+import type { TAttachment, UIResource } from 'librechat-data-provider';
+
+export function isSupportedUIResource(
+  resource: UIResource | null | undefined,
+): resource is UIResource {
+  return (
+    typeof resource?.mimeType === 'string' &&
+    resource.mimeType.split(';', 1)[0].trim().toLowerCase() === 'text/html'
+  );
+}
+
+/**
+ * The renderable MCP-UI resources carried by a tool call's attachments. This is the single
+ * definition of "this call produced a card": ToolCallInfo renders exactly this list, and
+ * ToolCall / ToolCallGroup use it to decide whether to reveal the call by default.
+ */
+export function getSupportedUIResources(attachments?: TAttachment[] | null): UIResource[] {
+  return (
+    attachments
+      ?.filter((attachment) => attachment.type === Tools.ui_resources)
+      .flatMap((attachment) => attachment[Tools.ui_resources] as UIResource[])
+      .filter(isSupportedUIResource) ?? []
+  );
+}
