+import React from 'react';
+import { RecoilRoot } from 'recoil';
+import { Tools } from 'librechat-data-provider';
+import { render, screen, fireEvent } from '@testing-library/react';
+import type { TAttachment } from 'librechat-data-provider';
+import ToolCall from '../ToolCall';
+
+/**
+ * Integration: the real ToolCall, ToolCallInfo and MCP-UI renderer together. Only localisation
+ * and the progress timer are stubbed; everything that decides whether the card is visible and
+ * how it is sandboxed is the production code.
+ */
+jest.mock('~/hooks', () => ({
+  useLocalize: () => (key: string, values?: Record<string, string>) =>
+    ({
+      com_ui_output: 'Output',
+      com_ui_parameters: 'Parameters',
+      com_assistants_completed_function: `Completed ${values?.[0]}`,
+    })[key] ?? key,
+  useProgress: (p: number) => (p >= 1 ? 1 : p),
+  useExpandCollapse: (isExpanded: boolean) => ({
+    style: { display: 'grid', gridTemplateRows: isExpanded ? '1fr' : '0fr' },
+    ref: { current: null },
+  }),
+  useLazyCollapseBody: jest.requireActual('~/hooks/Messages/useLazyCollapseBody').default,
+}));
+
+jest.mock('~/hooks/MCP', () => ({
+  useMCPIconMap: () => new Map(),
+  useMCPServerNames: () => [],
+}));
+
+jest.mock('~/Providers', () => ({
+  useOptionalMessagesOperations: () => ({ ask: jest.fn() }),
+}));
+
+jest.mock('../Parts', () => ({ AttachmentGroup: () => null }));
+
+/** A fictional card in the shape an MCP server returns it: figures plus an unconfirmed caveat the
+ *  model's own answer may leave out. Nothing here names a product, server or customer. */
+const CAVEAT = 'Unconfirmed: this amount is worked out and has not been confirmed.';
+const CARD_HTML = `<!doctype html><html><body><h1>Harbour Demo Supplies</h1><p>Amount due: AUD 2,580.00</p><p class="caveat">${CAVEAT}</p></body></html>`;
+
+const cardAttachment = (toolCallId: string, text = CARD_HTML): TAttachment =>
+  ({
+    type: Tools.ui_resources,
+    messageId: 'm1',
+    toolCallId,
+    conversationId: 'c1',
+    [Tools.ui_resources]: [
+      {
+        resourceId: `r-${toolCallId}`,
+        uri: `ui://demo/${toolCallId}`,
+        mimeType: 'text/html',
+        text,
+      },
+    ],
+  }) as unknown as TAttachment;
+
+const props = {
+  args: '{"customer":"C-DEMO-02"}',
+  name: 'customerOverview_mcp_demo',
+  output: '{"amount":"AUD 2,580.00"}',
+  initialProgress: 1,
+  isSubmitting: false,
+  toolCallId: 'tc1',
+};
+
+const renderCall = (attachments?: TAttachment[]) =>
+  render(
+    <RecoilRoot>
+      <ToolCall {...props} attachments={attachments} />
+      <p data-testid="final-answer">{'The amount due is AUD 2,580.00.'}</p>
+    </RecoilRoot>,
+  );
+
+describe('ToolCall with a real MCP-UI card', () => {
+  it('shows the card without a click, with a caveat the final answer omits', () => {
+    renderCall([cardAttachment('tc1')]);
+    const iframe = document.querySelector('iframe') as HTMLIFrameElement;
+    expect(iframe).not.toBeNull();
+    expect(iframe.getAttribute('srcdoc')).toContain(CAVEAT);
+    expect(screen.getByTestId('final-answer').textContent).not.toContain('Unconfirmed');
+    expect(document.querySelector('[data-tool-call-output-id="tc1"]')).toHaveStyle({
+      gridTemplateRows: '1fr',
+    });
+  });
+
+  it('puts the card above the raw output and keeps the raw output reachable', () => {
+    renderCall([cardAttachment('tc1')]);
+    const iframe = document.querySelector('iframe') as HTMLIFrameElement;
+    const toggle = screen.getByRole('button', { name: /Output/ });
+    expect(toggle).toHaveAttribute('aria-expanded', 'false');
+    expect(iframe.compareDocumentPosition(toggle) & Node.DOCUMENT_POSITION_FOLLOWING).toBeTruthy();
+    fireEvent.click(toggle);
+    expect(toggle).toHaveAttribute('aria-expanded', 'true');
+    expect(toggle.nextElementSibling).toHaveTextContent('2,580.00');
+  });
+
+  it('renders the card in a script-only sandbox, never same-origin', () => {
+    renderCall([cardAttachment('tc1')]);
+    const iframe = document.querySelector('iframe') as HTMLIFrameElement;
+    expect(iframe.getAttribute('sandbox')).toBe('allow-scripts');
+  });
+
+  it('does not render any iframe for a call without a card, and keeps it closed', () => {
+    renderCall(undefined);
+    expect(document.querySelector('iframe')).toBeNull();
+    expect(document.querySelector('[data-tool-call-output-id="tc1"]')).toHaveStyle({
+      gridTemplateRows: '0fr',
+    });
+  });
+
+  it('opens when the saved attachment is hydrated after the first render', () => {
+    const { rerender } = renderCall(undefined);
+    expect(document.querySelector('iframe')).toBeNull();
+    rerender(
+      <RecoilRoot>
+        <ToolCall {...props} attachments={[cardAttachment('tc1')]} />
+      </RecoilRoot>,
+    );
+    expect(
+      (document.querySelector('iframe') as HTMLIFrameElement).getAttribute('srcdoc'),
+    ).toContain(CAVEAT);
+  });
+});
