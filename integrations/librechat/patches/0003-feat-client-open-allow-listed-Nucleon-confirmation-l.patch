+/**
+ * Nucleon patch 0003: the only way an embedded MCP-UI resource may open a page.
+ *
+ * Origins a card's `link` action may open. This is a build-time constant: change
+ * it by rebuilding the image. A remote deployment needs an authenticated HTTPS
+ * origin added here; plain-http loopback origins are for the local runtime only.
+ */
+export const ALLOWED_ORIGINS: readonly string[] = [
+  'http://127.0.0.1:8631',
+  'http://127.0.0.1:18631',
+];
+
+const ACTION_HASH = /^#\/actions\/act_[0-9a-f]{16}$/;
+/** Whitespace and C0/C1 control characters anywhere in the raw string. */
+// eslint-disable-next-line no-control-regex
+const FORBIDDEN_CHARS = /[\s\u0000-\u001f\u007f-\u009f]/;
+
+/**
+ * Returns the normalised URL when `raw` is exactly `<allowed origin>/#/actions/act_<16 hex>`
+ * (no credentials, query, other path or encoding tricks), otherwise null.
+ */
+export function validateConfirmLink(raw: unknown): string | null {
+  if (typeof raw !== 'string' || raw.length === 0 || FORBIDDEN_CHARS.test(raw)) {
+    return null;
+  }
+  let url: URL;
+  try {
+    url = new URL(raw);
+  } catch {
+    return null;
+  }
+  if (
+    url.protocol !== 'http:' ||
+    !ALLOWED_ORIGINS.includes(url.origin) ||
+    url.username !== '' ||
+    url.password !== '' ||
+    url.pathname !== '/' ||
+    url.search !== '' ||
+    !ACTION_HASH.test(url.hash) ||
+    /* canonical form only: also rejects a bare `?`, which leaves `search` empty */
+    url.href !== `${url.origin}/${url.hash}` ||
+    url.href !== raw
+  ) {
+    return null;
+  }
+  return url.href;
+}
+
+/** True only while the user's click is still a live (transient) activation. */
+export function hasUserActivation(): boolean {
+  return typeof navigator !== 'undefined' && navigator.userActivation?.isActive === true;
+}
+
+/**
+ * Opens a validated confirmation link in a new tab. Never throws, never reports the URL.
+ * Returns whether a window was requested.
+ */
+export function openConfirmLink(payload: unknown): boolean {
+  const raw =
+    payload != null && typeof payload === 'object' ? (payload as { url?: unknown }).url : undefined;
+  const href = validateConfirmLink(raw);
+  if (href == null || !hasUserActivation()) {
+    console.warn('MCP-UI link action ignored');
+    return false;
+  }
+  window.open(href, '_blank', 'noopener,noreferrer');
+  return true;
+}
